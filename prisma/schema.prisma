generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Клиент для api/ (NestJS) на время переноса — см. MIGRATION-NESTJS.md, раздел 3.
// Схема одна на оба приложения, миграциями до этапа 9 владеет web.
// Генерируется из api: npm run prisma:generate.
generator apiClient {
  provider = "prisma-client-js"
  output   = "../api/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

// Кем родитель приходится ученику. Нужно администратору при звонке,
// а в тексте СМС — чтобы обратиться правильно.
enum ParentRelation {
  MOTHER
  FATHER
  GUARDIAN
  OTHER
}

enum VideoSource {
  YOUTUBE
  UPLOAD
}

// Формат конспекта урока: markdown рендерится в prose,
// HTML — как самодостаточный документ в изолированном iframe.
enum LessonContentFormat {
  MARKDOWN
  HTML
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum AssessmentType {
  TEST
  EXAM
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum HomeworkType {
  CODE
  TEXT
  FILE
}

enum ProgrammingLanguage {
  PYTHON
  JAVASCRIPT
  TYPESCRIPT
  PHP
  JAVA
  CSHARP
}

enum SubmissionStatus {
  PENDING
  RUNNING
  PASSED
  PARTIAL
  FAILED
  ERROR
  TIMEOUT
}

enum ManualReviewStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION
}

// Режим записи на курс: закрытый (только преподавателем),
// бесплатный (мгновенная самозапись), платный (заявка + подтверждение)
enum CourseAccessType {
  CLOSED
  FREE
  PAID
}

enum EnrollmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Способ приёма оплаты в офлайн-центре
enum SmsStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum SmsTemplateStatus {
  DRAFT
  MODERATION
  APPROVED
  REJECTED
}

enum PaymentMethod {
  CASH
  CARD
  PAYME
  CLICK
  TRANSFER
}

model User {
  id           String    @id @default(cuid())
  number       Int       @unique @default(autoincrement())
  email        String?   @unique
  passwordHash String?
  firstName    String
  lastName     String
  phone        String?
  role         Role      @default(STUDENT)
  isActive     Boolean   @default(true)
  lastSeenAt   DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  courses                    Course[]
  enrollments                Enrollment[]
  assessmentAttempts         AssessmentAttempt[]
  attendanceRecords          AttendanceRecord[]
  lessonProgress             LessonProgress[]
  auditLogs                  AuditLog[]
  submissions                Submission[]
  reviewedSubmissions        Submission[]        @relation("ReviewedSubmissions")
  enrollmentRequests         EnrollmentRequest[] @relation("StudentEnrollmentRequests")
  reviewedEnrollmentRequests EnrollmentRequest[] @relation("ReviewedEnrollmentRequests")
  payments                   Payment[]           @relation("StudentPayments")
  recordedPayments           Payment[]           @relation("RecordedPayments")
  telegramChatId             String?             @unique
  telegramUsername           String?

  // Родитель ↔ ученик. Связь многие-ко-многим: у ученика может быть двое
  // родителей, у родителя — несколько детей в разных группах.
  telegramLinkRequests TelegramLinkRequest[]
  sessions             Session[]
  childLinks           ParentStudent[]       @relation("ParentOf")
  parentLinks          ParentStudent[]       @relation("ChildOf")

  // Преподавание: группы под ведением и проведённые занятия
  taughtGroups   Group[]             @relation("GroupTeacher")
  taughtSessions AttendanceSession[] @relation("SessionTeacher")

  smsMessages   SmsLog[]       @relation("SmsMessages")
  smsBroadcasts SmsBroadcast[] @relation("SmsBroadcasts")

  @@index([role])
  @@index([isActive])
  @@index([lastSeenAt])
  @@index([deletedAt])
}

// Связь родителя с учеником. Отдельная таблица, а не массив id: у связи
// есть собственные атрибуты — кем приходится и основной ли это контакт.
model ParentStudent {
  id String @id @default(cuid())

  parentId String
  parent   User   @relation("ParentOf", fields: [parentId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("ChildOf", fields: [studentId], references: [id], onDelete: Cascade)

  relation ParentRelation @default(OTHER)

  // Кому звонить и слать СМС первым, если родителей несколько.
  // Уникальности на уровне БД нет: «основных» может не быть вовсе,
  // а частичные индексы Prisma не выражает — следит серверное действие.
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([parentId, studentId])
  @@index([studentId])
  @@index([parentId])
}

model Course {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String?
  coverImage  String?
  isPublished Boolean   @default(false)
  isTemplate  Boolean   @default(false)
  sortOrder   Int       @default(0)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Запись студентов: CLOSED — только преподавателем, FREE — самозапись,
  // PAID — по заявке (оплата оффлайн, цена в поле price)
  accessType CourseAccessType @default(CLOSED)

  // Публичный лендинг (it-school-official.uz)
  isPublicListed  Boolean   @default(false)
  price           Int?
  publicSummaryRu String?
  publicSummaryUz String?
  intakeStartDate DateTime?
  intakeSeats     Int?
  intakeNoteRu    String?
  intakeNoteUz    String?

  teacherId String
  teacher   User   @relation(fields: [teacherId], references: [id])

  copiedFromId String?
  copiedFrom   Course?   @relation("CourseCopies", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies       Course[]  @relation("CourseCopies")
  copiedAt     DateTime?

  lessons            Lesson[]
  enrollments        Enrollment[]
  assessments        Assessment[]
  attendanceSessions AttendanceSession[]
  groups             Group[]
  enrollmentRequests EnrollmentRequest[]
  payments           Payment[]

  @@index([teacherId])
  @@index([isPublished])
  @@index([isTemplate])
  @@index([copiedFromId])
  @@index([deletedAt])
  @@index([isPublicListed])
  @@index([accessType])
}

// Заявка студента на платный курс; одна запись на пару курс+студент,
// повторная подача после отклонения переводит REJECTED → PENDING
model EnrollmentRequest {
  id        String                  @id @default(cuid())
  status    EnrollmentRequestStatus @default(PENDING)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("StudentEnrollmentRequests", fields: [studentId], references: [id], onDelete: Cascade)

  reviewedById String?
  reviewedBy   User?     @relation("ReviewedEnrollmentRequests", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  @@unique([courseId, studentId])
  @@index([status])
  @@index([studentId])
}

// Оплата студента, принятая офлайн (касса учебного центра).
// Журнал внесений: одна запись = один платёж, правок суммы нет — ошибочную
// запись помечают deletedAt и вносят заново.
model Payment {
  id        String        @id @default(cuid())
  amount    Int // UZS, без копеек — как Course.price
  method    PaymentMethod @default(CASH)
  paidAt    DateTime // дата приёма денег (полдень UTC, см. payment-actions)
  // Период, за который платят, в формате "YYYY-MM". Строка, а не @db.Date:
  // Date-поля срезаются на день назад для таймзон впереди UTC (см. AttendanceSession).
  forMonth  String?
  comment   String?
  deletedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  studentId String
  student   User   @relation("StudentPayments", fields: [studentId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  // Кто принял оплату; запись остаётся при удалении сотрудника
  createdById String
  createdBy   User   @relation("RecordedPayments", fields: [createdById], references: [id])

  @@index([studentId])
  @@index([courseId])
  @@index([groupId])
  @@index([paidAt])
  @@index([forMonth])
  @@index([deletedAt])
  @@index([createdById])
}

model CourseLead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  fullName  String
  phone     String
  message   String?
  contacted Boolean  @default(false)

  // Название курса лендинга (статичный список в src/lib/marketing-courses.ts) —
  // заявки не привязаны к курсам платформы.
  courseName String

  @@index([contacted])
}

model Enrollment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ─── Биллинг ────────────────────────────────────────────────────────────
  // Первый учебный день. Отдельно от createdAt: строку в базе могли завести
  // раньше или позже, чем студент реально начал ходить.
  startsAt         DateTime?
  // Последний оплачиваемый день: студент ушёл или встал на паузу. Начисления
  // после этой даты прекращаются, история оплат остаётся.
  billingEndsAt    DateTime?
  // Индивидуальная цена за месяц вместо Course.price (скидка/надбавка)
  priceOverride    Int?
  // Начисление за первый неполный месяц. Считается по занятиям, но хранится
  // отдельно: админ округляет сумму рукой, иначе дробный остаток навсегда
  // повесит студента в должниках (Payment.amount — целое число сумов).
  firstMonthCharge Int?

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  monthlyCharges MonthlyCharge[]

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([groupId])
}

// Зафиксированное начисление за календарный месяц.
//
// До этой таблицы долг существовал только как результат пересчёта на лету:
// chargeSchedule заново считал всю историю от ТЕКУЩИХ цен при каждом открытии
// страницы. Любая правка цены переписывала прошлое — студент, закрывший
// сентябрь, задним числом становился должником. Теперь закрытый месяц
// читается отсюда, а открытый (текущий и будущие) по-прежнему считается
// формулой: пока месяц идёт, начисление ещё может измениться законно.
model MonthlyCharge {
  id String @id @default(cuid())

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  // Календарный месяц "YYYY-MM" строкой, как Payment.forMonth: Date-поля
  // срезаются на день назад в таймзонах впереди UTC.
  month String

  amount      Int
  basis       String // full | lessons | days | manual | none
  unitsTotal  Int
  unitsBilled Int

  // Цена, по которой посчитали. Без неё через год не объяснить, почему
  // за сентябрь вышло одно число, а за октябрь другое.
  priceUsed Int

  // Проставлен — месяц закрыт и пересчёту не подлежит
  lockedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrollmentId, month])
  @@index([month])
  @@index([lockedAt])
}

model Group {
  id           String    @id @default(cuid())
  name         String
  description  String?
  // Расписание в свободной форме — для показа («Пн/Ср/Пт 18:00»)
  schedule     String?
  // Дни занятий по ISO (1 = понедельник … 7 = воскресенье). Нужны для
  // пропорционального начисления за неполный месяц: считаем занятия, а не дни.
  // Пустой массив — расписание не задано, пропорцию админ вводит вручную.
  scheduleDays Int[]
  startDate    DateTime?
  endDate      DateTime?
  // Цена группы за месяц. Пусто — берётся цена курса. Индивидуальная цена
  // студента (Enrollment.priceOverride) важнее цены группы. Меняется только
  // вперёд: закрытые месяцы уже лежат в MonthlyCharge со своей priceUsed.
  price        Int?
  settings     Json?
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Преподаватель группы. Course.teacherId задаёт одного педагога на весь
  // курс — этого мало: две группы одного курса могут вести разные люди.
  // Необязательный: пока не заполнен, отчёты берут преподавателя курса.
  teacherId String?
  teacher   User?   @relation("GroupTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  enrollments        Enrollment[]
  attendanceSessions AttendanceSession[]
  payments           Payment[]
  smsBroadcasts      SmsBroadcast[]

  @@unique([courseId, name])
  @@index([teacherId])
  @@index([courseId])
  @@index([isActive])
}

model Lesson {
  id            String              @id @default(cuid())
  slug          String
  title         String
  content       String              @default("")
  contentFormat LessonContentFormat @default(MARKDOWN)
  videoUrl      String?
  videoSource   VideoSource?
  sortOrder     Int                 @default(0)
  isPublished   Boolean             @default(false)
  deletedAt     DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  assessment Assessment?
  homeworks  Homework[]
  progress   LessonProgress[]

  @@unique([courseId, slug])
  @@index([courseId])
  @@index([sortOrder])
  @@index([deletedAt])
}

// Код подтверждения email при регистрации: один активный код на адрес
/// Сессия входа. Хранится в базе, а не в JWT: так выход, смена пароля и
/// деактивация обрывают доступ сразу, а не через 30 дней (аудит 2.1).
/// В базе лежит хэш токена — утечка таблицы не даёт войти под чужим именем.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ip         String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationCode {
  id        String   @id @default(cuid())
  email     String   @unique
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  sentAt    DateTime @default(now())
}

// Одноразовая заявка на вход через Telegram-бота (deep-link t.me/bot?start=login_<code>)
// Код привязки Telegram к существующему аккаунту: пользователь жмёт
// «привязать» в кабинете и отправляет код боту. Раньше код клали прямо в
// User.telegramChatId как "pending:<код>" — вторая попытка затирала реальный
// chat id, и вход через Telegram терялся навсегда (аудит 2.8).
model TelegramLinkRequest {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TelegramAuthRequest {
  id               String   @id @default(cuid())
  code             String   @unique
  status           String   @default("PENDING") // PENDING | CONFIRMED
  telegramChatId   String?
  telegramUsername String?
  firstName        String?
  lastName         String?
  createdAt        DateTime @default(now())
  expiresAt        DateTime

  @@index([expiresAt])
}

model AttendanceSession {
  id   String   @id @default(cuid())
  date DateTime @db.Date
  note String?

  // ─── Преподаватель ──────────────────────────────────────────────────────
  // Кто фактически вёл занятие. Может отличаться от преподавателя группы:
  // замена, второй педагог, смена в середине курса.
  teacherId     String?
  teacher       User?             @relation("SessionTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  teacherStatus AttendanceStatus?
  teacherNote   String?

  // Фактическое время занятия. Заполняется по желанию и нужно не отметке,
  // а будущему учёту часов — чтобы не заводить под него ещё одну миграцию.
  startedAt DateTime?
  endedAt   DateTime?

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  records AttendanceRecord[]

  // Для занятий БЕЗ группы это правило не работает: в Postgres NULL не равен
  // NULL, и дубликаты проходили. Их закрывает частичный уникальный индекс
  // (courseId, date) WHERE "groupId" IS NULL — Prisma такие описывать не умеет,
  // он создан миграцией 20260916090000_attendance_no_group_unique.
  @@unique([courseId, date, groupId])
  @@index([courseId])
  @@index([groupId])
  @@index([teacherId])
  @@index([date])
}

model AttendanceRecord {
  id     String           @id @default(cuid())
  status AttendanceStatus
  note   String?

  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model LessonProgress {
  id           String    @id @default(cuid())
  completedAt  DateTime?
  watchTime    Int       @default(0)
  lastPosition Float     @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([studentId])
  @@index([lessonId])
}

// =============================================
// Unified Assessment models
// =============================================

model Assessment {
  id           String         @id @default(cuid())
  type         AssessmentType
  title        String
  description  String?
  passingScore Int            @default(60)
  timeLimitMin Int?
  maxAttempts  Int            @default(1)
  sortOrder    Int            @default(0)
  isPublished  Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessonId String? @unique
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]

  @@index([courseId])
  @@index([type])
}

model AssessmentQuestion {
  id        String       @id @default(cuid())
  text      String
  type      QuestionType
  points    Int          @default(1)
  sortOrder Int          @default(0)

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  options        AssessmentAnswerOption[]
  attemptAnswers AssessmentAttemptAnswer[]

  @@index([assessmentId])
}

model AssessmentAnswerOption {
  id        String  @id @default(cuid())
  text      String
  isCorrect Boolean @default(false)
  sortOrder Int     @default(0)

  questionId String
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model AssessmentAttempt {
  id            String    @id @default(cuid())
  score         Int       @default(0)
  maxScore      Int       @default(0)
  percentage    Float     @default(0)
  isPassed      Boolean   @default(false)
  // Попытка создаётся при старте, а не при отправке: без этого серверу нечем
  // проверить ограничение по времени — startedAt совпадал с completedAt, и
  // таймер existовал только в браузере (аудит 3.3).
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  // Номер попытки. Уникальность пары (тест, ученик, номер) не даёт двум
  // параллельным запросам создать лишнюю попытку сверх лимита: count() внутри
  // транзакции от гонки не защищал (аудит 3.4).
  attemptNumber Int       @default(1)

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  answers AssessmentAttemptAnswer[]

  @@unique([assessmentId, studentId, attemptNumber])
  @@index([studentId])
  @@index([assessmentId])
}

model AssessmentAttemptAnswer {
  id                String   @id @default(cuid())
  selectedOptionIds String[]
  isCorrect         Boolean  @default(false)
  pointsEarned      Int      @default(0)

  attemptId String
  attempt   AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId String
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// =============================================
// Audit Log
// =============================================

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  changes    Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

// =============================================
// Homework Auto-Check
// =============================================

model Homework {
  id           String               @id @default(cuid())
  slug         String
  title        String
  description  String
  type         HomeworkType         @default(CODE)
  language     ProgrammingLanguage?
  starterCode  String?
  solutionCode String?
  maxAttempts  Int                  @default(10)
  timeLimitSec Int                  @default(5)
  maxScore     Int                  @default(100)
  passingScore Int                  @default(60)
  dueDate      DateTime?
  allowLate    Boolean              @default(true)
  latePenalty  Int                  @default(20)
  sortOrder    Int                  @default(0)
  isPublished  Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  requiresManualReview Boolean @default(false)
  reviewInstructions   String?

  testCases   TestCase[]
  submissions Submission[]

  @@unique([lessonId, slug])
  @@index([lessonId])
  @@index([isPublished])
}

model TestCase {
  id          String  @id @default(cuid())
  input       String
  expected    String
  isHidden    Boolean @default(false)
  points      Int     @default(1)
  description String?
  sortOrder   Int     @default(0)

  homeworkId String
  homework   Homework     @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  results    TestResult[]

  @@index([homeworkId])
}

model Submission {
  id            String           @id @default(cuid())
  code          String
  status        SubmissionStatus @default(PENDING)
  score         Int              @default(0)
  maxScore      Int              @default(0)
  percentage    Float            @default(0)
  executionTime Int?
  errorMessage  String?
  isLate        Boolean          @default(false)
  penalty       Int              @default(0)
  finalScore    Float            @default(0)
  attemptNumber Int              @default(1)
  createdAt     DateTime         @default(now())

  manualStatus   ManualReviewStatus?
  teacherComment String?
  reviewedById   String?
  reviewedBy     User?               @relation("ReviewedSubmissions", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  manualScore    Int?

  studentId   String
  student     User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  homeworkId  String
  homework    Homework         @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  testResults TestResult[]
  files       SubmissionFile[]

  // Номер попытки уникален на пару (задание, ученик): две параллельные сдачи
  // не займут один номер, и лимит попыток не обходится гонкой (аудит 3.4)
  @@unique([homeworkId, studentId, attemptNumber])
  @@index([studentId])
  @@index([homeworkId])
  @@index([manualStatus])
}

model SubmissionFile {
  id        String   @id @default(cuid())
  filename  String
  path      String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model TestResult {
  id            String  @id @default(cuid())
  passed        Boolean
  actualOutput  String?
  errorOutput   String?
  executionTime Int?

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCaseId   String
  testCase     TestCase   @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

// ─── Контент маркетингового лендинга (it-school-official.uz) ─────────────
// Отдельные таблицы, не связанные с курсами платформы: лендинг редактируется
// из админки (/admin/landing) и публикуется без деплоя.

model MarketingCourse {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  summaryRu       String?
  summaryUz       String?
  cover           String?
  price           Int?
  intakeStartDate DateTime?
  intakeSeats     Int?
  intakeNoteRu    String?
  intakeNoteUz    String?
  sortOrder       Int       @default(0)
  published       Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([published, sortOrder])
}

model MarketingReel {
  id        String   @id @default(cuid())
  url       String
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([published, sortOrder])
}

model MarketingGalleryItem {
  id        String   @id @default(cuid())
  image     String
  titleRu   String
  titleUz   String
  textRu    String
  textUz    String
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([published, sortOrder])
}

model MarketingTestimonial {
  id        String   @id @default(cuid())
  quoteRu   String
  quoteUz   String
  author    String
  roleRu    String
  roleUz    String
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([published, sortOrder])
}

// Тексты лендинга: ключ = путь в messages (например "hero.title").
// Отсутствующий ключ → фолбэк на src/i18n/messages/{ru,uz}.json.
// Настройки, общие для CRM и лендинга. Key-value, а не колонки: значений
// единицы, и каждое новое не должно стоить миграции.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model MarketingText {
  key       String   @id
  ru        String
  uz        String
  updatedAt DateTime @updatedAt
}

// Произвольные страницы лендинга (it-school-official.uz/<slug>): детальные страницы
// курсов, «О нас», политика и т.п. Контент — JSON блочного редактора Editor.js.
model MarketingPage {
  id           String   @id @default(cuid())
  slug         String   @unique
  titleRu      String
  titleUz      String
  contentRu    Json?
  contentUz    Json?
  seoTitleRu   String?
  seoTitleUz   String?
  seoDescRu    String?
  seoDescUz    String?
  showInFooter Boolean  @default(false)
  published    Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published])
}

// ─── СМС через eskiz.uz ───────────────────────────────────────────────────

// Токен внешнего сервиса. В БД, а не в памяти процесса: контейнер
// перезапускается на каждом деплое, и логин уходил бы заново.
model IntegrationToken {
  id        String   @id @default(cuid())
  provider  String   @unique
  token     String
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

// Зеркало шаблонов Eskiz. Отправка разрешена только со статусом APPROVED:
// шлюз отобьёт несогласованный текст, а попытка уже стоит денег.
model SmsTemplate {
  id      String            @id @default(cuid())
  eskizId Int?              @unique
  title   String
  textRu  String
  textUz  String
  status  SmsTemplateStatus @default(DRAFT)

  syncedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  broadcasts SmsBroadcast[]

  @@index([status])
}

// Одна рассылка — один dispatch_id у Eskiz. Нужна, чтобы видеть
// «доставлено 28 из 30» и кому именно не дошло.
model SmsBroadcast {
  id         String @id @default(cuid())
  dispatchId String @unique

  templateId String?
  template   SmsTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("SmsBroadcasts", fields: [createdById], references: [id])

  total     Int
  createdAt DateTime @default(now())

  messages SmsLog[]

  @@index([groupId])
  @@index([createdAt])
}

// Журнал обязателен: СМС стоят денег. price и parts храним потому, что
// иначе не объяснить, почему длинное сообщение списало втрое больше.
model SmsLog {
  id     String    @id @default(cuid())
  phone  String
  text   String
  status SmsStatus @default(QUEUED)

  // id сообщения у Eskiz и наш собственный: второй возвращается в статусе
  // пакета и связывает ответ шлюза с конкретной строкой журнала.
  providerId String?
  userSmsId  String? @unique

  price Int?
  parts Int?
  error String?

  userId String?
  user   User?   @relation("SmsMessages", fields: [userId], references: [id], onDelete: SetNull)

  broadcastId String?
  broadcast   SmsBroadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  @@index([phone])
  @@index([status])
  @@index([broadcastId])
  @@index([createdAt])
}
