generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum VideoSource {
  YOUTUBE
  UPLOAD
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum AssessmentType {
  TEST
  EXAM
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum HomeworkType {
  CODE
  TEXT
  FILE
}

enum ProgrammingLanguage {
  PYTHON
  JAVASCRIPT
  TYPESCRIPT
  PHP
  JAVA
  CSHARP
}

enum SubmissionStatus {
  PENDING
  RUNNING
  PASSED
  PARTIAL
  FAILED
  ERROR
  TIMEOUT
}

enum ManualReviewStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION
}

// Режим записи на курс: закрытый (только преподавателем),
// бесплатный (мгновенная самозапись), платный (заявка + подтверждение)
enum CourseAccessType {
  CLOSED
  FREE
  PAID
}

enum EnrollmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String    @id @default(cuid())
  email        String?   @unique
  passwordHash String?
  firstName    String
  lastName     String
  phone        String?
  role         Role      @default(STUDENT)
  isActive     Boolean   @default(true)
  lastSeenAt   DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  courses              Course[]
  enrollments          Enrollment[]
  assessmentAttempts   AssessmentAttempt[]
  attendanceRecords    AttendanceRecord[]
  lessonProgress       LessonProgress[]
  auditLogs            AuditLog[]
  submissions          Submission[]
  reviewedSubmissions  Submission[]  @relation("ReviewedSubmissions")
  enrollmentRequests         EnrollmentRequest[] @relation("StudentEnrollmentRequests")
  reviewedEnrollmentRequests EnrollmentRequest[] @relation("ReviewedEnrollmentRequests")
  telegramChatId       String?   @unique
  telegramUsername     String?

  @@index([role])
  @@index([isActive])
  @@index([lastSeenAt])
  @@index([deletedAt])
}

model Course {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String?
  coverImage  String?
  isPublished Boolean   @default(false)
  isTemplate  Boolean   @default(false)
  sortOrder   Int       @default(0)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Запись студентов: CLOSED — только преподавателем, FREE — самозапись,
  // PAID — по заявке (оплата оффлайн, цена в поле price)
  accessType CourseAccessType @default(CLOSED)

  // Публичный лендинг (uportal.uz)
  isPublicListed  Boolean   @default(false)
  price           Int?
  publicSummaryRu String?
  publicSummaryUz String?
  intakeStartDate DateTime?
  intakeSeats     Int?
  intakeNoteRu    String?
  intakeNoteUz    String?

  teacherId String
  teacher   User   @relation(fields: [teacherId], references: [id])

  copiedFromId String?
  copiedFrom   Course?   @relation("CourseCopies", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies       Course[]  @relation("CourseCopies")
  copiedAt     DateTime?

  lessons            Lesson[]
  enrollments        Enrollment[]
  assessments        Assessment[]
  attendanceSessions AttendanceSession[]
  groups             Group[]
  enrollmentRequests EnrollmentRequest[]

  @@index([teacherId])
  @@index([isPublished])
  @@index([isTemplate])
  @@index([copiedFromId])
  @@index([deletedAt])
  @@index([isPublicListed])
  @@index([accessType])
}

// Заявка студента на платный курс; одна запись на пару курс+студент,
// повторная подача после отклонения переводит REJECTED → PENDING
model EnrollmentRequest {
  id        String                  @id @default(cuid())
  status    EnrollmentRequestStatus @default(PENDING)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("StudentEnrollmentRequests", fields: [studentId], references: [id], onDelete: Cascade)

  reviewedById String?
  reviewedBy   User?     @relation("ReviewedEnrollmentRequests", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  @@unique([courseId, studentId])
  @@index([status])
  @@index([studentId])
}

model CourseLead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  fullName  String
  phone     String
  message   String?
  contacted Boolean  @default(false)

  // Название курса лендинга (статичный список в src/lib/marketing-courses.ts) —
  // заявки не привязаны к курсам платформы.
  courseName String

  @@index([contacted])
}

model Enrollment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  courseId String
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([groupId])
}

model Group {
  id          String    @id @default(cuid())
  name        String
  description String?
  schedule    String?
  startDate   DateTime?
  endDate     DateTime?
  settings    Json?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  courseId String
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  enrollments        Enrollment[]
  attendanceSessions AttendanceSession[]

  @@unique([courseId, name])
  @@index([courseId])
  @@index([isActive])
}

model Lesson {
  id          String       @id @default(cuid())
  slug        String
  title       String
  content     String       @default("")
  videoUrl    String?
  videoSource VideoSource?
  sortOrder   Int          @default(0)
  isPublished Boolean      @default(false)
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  courseId String
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  assessment Assessment?
  homeworks  Homework[]
  progress   LessonProgress[]

  @@unique([courseId, slug])
  @@index([courseId])
  @@index([sortOrder])
  @@index([deletedAt])
}

// Код подтверждения email при регистрации: один активный код на адрес
model EmailVerificationCode {
  id        String   @id @default(cuid())
  email     String   @unique
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  sentAt    DateTime @default(now())
}

// Одноразовая заявка на вход через Telegram-бота (deep-link t.me/bot?start=login_<code>)
model TelegramAuthRequest {
  id               String   @id @default(cuid())
  code             String   @unique
  status           String   @default("PENDING") // PENDING | CONFIRMED
  telegramChatId   String?
  telegramUsername String?
  firstName        String?
  lastName         String?
  createdAt        DateTime @default(now())
  expiresAt        DateTime

  @@index([expiresAt])
}

model AttendanceSession {
  id   String   @id @default(cuid())
  date DateTime @db.Date
  note String?

  courseId String
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  records AttendanceRecord[]

  @@unique([courseId, date, groupId])
  @@index([courseId])
  @@index([groupId])
}

model AttendanceRecord {
  id     String           @id @default(cuid())
  status AttendanceStatus
  note   String?

  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  studentId String
  student   User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model LessonProgress {
  id           String    @id @default(cuid())
  completedAt  DateTime?
  watchTime    Int       @default(0)
  lastPosition Float     @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  studentId String
  student   User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([studentId])
  @@index([lessonId])
}

// =============================================
// Unified Assessment models
// =============================================

model Assessment {
  id           String         @id @default(cuid())
  type         AssessmentType
  title        String
  description  String?
  passingScore Int            @default(60)
  timeLimitMin Int?
  maxAttempts  Int            @default(1)
  sortOrder    Int            @default(0)
  isPublished  Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  courseId String
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessonId String? @unique
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]

  @@index([courseId])
  @@index([type])
}

model AssessmentQuestion {
  id        String       @id @default(cuid())
  text      String
  type      QuestionType
  points    Int          @default(1)
  sortOrder Int          @default(0)

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  options        AssessmentAnswerOption[]
  attemptAnswers AssessmentAttemptAnswer[]

  @@index([assessmentId])
}

model AssessmentAnswerOption {
  id        String  @id @default(cuid())
  text      String
  isCorrect Boolean @default(false)
  sortOrder Int     @default(0)

  questionId String
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model AssessmentAttempt {
  id          String    @id @default(cuid())
  score       Int       @default(0)
  maxScore    Int       @default(0)
  percentage  Float     @default(0)
  isPassed    Boolean   @default(false)
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  studentId String
  student   User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  answers AssessmentAttemptAnswer[]

  @@index([studentId])
  @@index([assessmentId])
}

model AssessmentAttemptAnswer {
  id                String   @id @default(cuid())
  selectedOptionIds String[]
  isCorrect         Boolean  @default(false)
  pointsEarned      Int      @default(0)

  attemptId String
  attempt   AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId String
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// =============================================
// Audit Log
// =============================================

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  changes    Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

// =============================================
// Homework Auto-Check
// =============================================

model Homework {
  id            String              @id @default(cuid())
  slug          String
  title         String
  description   String
  type          HomeworkType        @default(CODE)
  language      ProgrammingLanguage?
  starterCode   String?
  solutionCode  String?
  maxAttempts   Int                 @default(10)
  timeLimitSec  Int                 @default(5)
  maxScore      Int                 @default(100)
  passingScore  Int                 @default(60)
  dueDate       DateTime?
  allowLate     Boolean             @default(true)
  latePenalty   Int                 @default(20)
  sortOrder     Int                 @default(0)
  isPublished   Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  lessonId      String
  lesson        Lesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  requiresManualReview Boolean   @default(false)
  reviewInstructions   String?

  testCases     TestCase[]
  submissions   Submission[]

  @@unique([lessonId, slug])
  @@index([lessonId])
  @@index([isPublished])
}

model TestCase {
  id          String   @id @default(cuid())
  input       String
  expected    String
  isHidden    Boolean  @default(false)
  points      Int      @default(1)
  description String?
  sortOrder   Int      @default(0)

  homeworkId  String
  homework    Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  results     TestResult[]

  @@index([homeworkId])
}

model Submission {
  id            String           @id @default(cuid())
  code          String
  status        SubmissionStatus @default(PENDING)
  score         Int              @default(0)
  maxScore      Int              @default(0)
  percentage    Float            @default(0)
  executionTime Int?
  errorMessage  String?
  isLate        Boolean          @default(false)
  penalty       Int              @default(0)
  finalScore    Float            @default(0)
  attemptNumber Int              @default(1)
  createdAt     DateTime         @default(now())

  manualStatus   ManualReviewStatus?
  teacherComment String?
  reviewedById   String?
  reviewedBy     User?            @relation("ReviewedSubmissions", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  manualScore    Int?

  studentId     String
  student       User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  homeworkId    String
  homework      Homework         @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  testResults   TestResult[]
  files         SubmissionFile[]

  @@index([studentId])
  @@index([homeworkId])
  @@index([manualStatus])
}

model SubmissionFile {
  id           String     @id @default(cuid())
  filename     String
  path         String
  mimeType     String
  size         Int
  createdAt    DateTime   @default(now())

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model TestResult {
  id            String   @id @default(cuid())
  passed        Boolean
  actualOutput  String?
  errorOutput   String?
  executionTime Int?

  submissionId  String
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCaseId    String
  testCase      TestCase   @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

// ─── Контент маркетингового лендинга (uportal.uz) ────────────────────────
// Отдельные таблицы, не связанные с курсами платформы: лендинг редактируется
// из админки (/admin/landing) и публикуется без деплоя.

model MarketingCourse {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  summaryRu       String?
  summaryUz       String?
  cover           String?
  price           Int?
  intakeStartDate DateTime?
  intakeSeats     Int?
  intakeNoteRu    String?
  intakeNoteUz    String?
  sortOrder       Int       @default(0)
  published       Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([published, sortOrder])
}

model MarketingReel {
  id        String   @id @default(cuid())
  url       String
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([published, sortOrder])
}

model MarketingGalleryItem {
  id        String   @id @default(cuid())
  image     String
  titleRu   String
  titleUz   String
  textRu    String
  textUz    String
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([published, sortOrder])
}

model MarketingTestimonial {
  id        String   @id @default(cuid())
  quoteRu   String
  quoteUz   String
  author    String
  roleRu    String
  roleUz    String
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([published, sortOrder])
}

// Тексты лендинга: ключ = путь в messages (например "hero.title").
// Отсутствующий ключ → фолбэк на src/i18n/messages/{ru,uz}.json.
model MarketingText {
  key       String   @id
  ru        String
  uz        String
  updatedAt DateTime @updatedAt
}

// Произвольные страницы лендинга (uportal.uz/<slug>): детальные страницы
// курсов, «О нас», политика и т.п. Контент — JSON блочного редактора Editor.js.
model MarketingPage {
  id           String   @id @default(cuid())
  slug         String   @unique
  titleRu      String
  titleUz      String
  contentRu    Json?
  contentUz    Json?
  seoTitleRu   String?
  seoTitleUz   String?
  seoDescRu    String?
  seoDescUz    String?
  showInFooter Boolean  @default(false)
  published    Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published])
}
