# Caddy терминирует TLS и раздаёт оба имени на одно приложение: лендинг и CRM
# разводятся внутри Next по заголовку Host (см. src/proxy.ts), поэтому важно
# передавать его как есть — Caddy делает это по умолчанию.
#
# Сертификаты Let's Encrypt выпускаются и продлеваются автоматически.

{
	email {$ACME_EMAIL}
}

# Лендинг
{$MARKETING_DOMAIN} {
	encode zstd gzip

	# Форма заявки на лендинге обращается к api по своему же домену: так
	# браузер считает запрос однодоменным и не нужен CORS. Маршрут тот же,
	# что и на домене CRM.
	handle /api/v2/* {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy app:3000
	}
}

# www — на канонический адрес без www
www.{$MARKETING_DOMAIN} {
	redir https://{$MARKETING_DOMAIN}{uri} permanent
}

# Личный кабинет / CRM
{$APP_DOMAIN} {
	encode zstd gzip

	# Перенос на NestJS: /api/v2/* обслуживает api, всё остальное — app.
	# Только на домене CRM: лендинг api не нужен.
	handle /api/v2/* {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy app:3000
	}

	# Браузер ходит на CRM только по HTTPS (аудит 2.10)
	header Strict-Transport-Security "max-age=31536000"
}
