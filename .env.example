# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bestdirection?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="your-secret-key-here"
AUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Upstash Redis (optional, for rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Piston API (code execution)
PISTON_API_URL="http://localhost:2000/api/v2"

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Email (Resend) — коды подтверждения регистрации
RESEND_API_KEY=
EMAIL_FROM="Best Direction <no-reply@bestdirection.uz>"

# Marketing landing domain (requests to this host / www.<this host> are routed to /marketing)
MARKETING_DOMAIN="bestdirection.uz"
