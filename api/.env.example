# Локальный запуск api: скопировать в api/.env и заполнить. npm run dev читает его сам.
# В проде переменные задаёт docker-compose.prod.yml.

# Та же база, что у web (DATABASE_URL в корневом .env)
DATABASE_URL="postgresql://bestdirection:bestdirectionpassword@localhost:5436/bestdirection?schema=public"

# Тот же секрет, что AUTH_SECRET у web: иначе api не прочитает сессию
AUTH_SECRET=""

# Адрес web: с него разрешены изменяющие запросы
APP_URL="http://localhost:3010"

# Любая случайная строка от 32 символов: openssl rand -hex 32
INTERNAL_TOKEN=""

PORT=4000
