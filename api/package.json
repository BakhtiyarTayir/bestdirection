{
  "name": "best-direction-api",
  "version": "0.1.0",
  "private": true,
  "description": "Бэкенд best-direction на NestJS — см. MIGRATION-NESTJS.md",
  "scripts": {
    "prisma:generate": "prisma generate --schema ../prisma/schema.prisma --generator apiClient",
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev --schema ../prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema ../prisma/schema.prisma",
    "db:seed": "npx tsx ../prisma/seed.ts",
    "db:export-logins": "npx tsx scripts/export-logins.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@casl/ability": "7.0.1",
    "@casl/prisma": "2.0.2",
    "@e965/xlsx": "0.20.3",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/throttler": "6.7.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "grammy": "1.46.0",
    "nestjs-zod": "5.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.17.7",
    "transliteration": "2.3.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.5",
    "@swc/core": "1.16.2",
    "@testcontainers/postgresql": "12.1.0",
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "24.13.5",
    "@types/sanitize-html": "2.16.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "prisma": "6.19.3",
    "supertest": "7.2.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "unplugin-swc": "1.6.0",
    "vitest": "5.0.1"
  },
  "overrides": {
    "multer": "2.4.0"
  }
}
